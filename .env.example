# ==========================================
# Tillwise Environment Configuration Example
# ==========================================

# 1. Supabase PostgreSQL Database (Transaction pooler / Direct URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-publishable-key"

# 2. OpenAI API Key (gpt-4o / gpt-4o-mini)
OPENAI_API_KEY="sk-proj-..."

# 3. Stripe Test Mode
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# 4. Cognee Memory Engine
COGNEE_API_KEY="cognee_..."
COGNEE_API_URL="https://[TENANT-ID].aws.cognee.ai"

# 5. App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
